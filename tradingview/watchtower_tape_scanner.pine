//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// WATCHTOWER TAPE SCANNER v1.9
// v1.9 (2026-09-01, Eric's META 15:35 read — "how is this good
// momentum?"): the MOMENTUM cell shows WHICH WAY the force points.
// The legs are mostly direction-blind (a crash-and-bounce scores like
// a clean run), so the label now carries the net direction of the six
// scoring bars — GOOD ▲ / GOOD ▼ (▼ = the force is a bear flush).
// Display only: thresholds, READY, and status are untouched.
// WATCHTOWER TAPE SCANNER v1.8 (history below)
// v1.8 (2026-09-01, the memory-error + one-truth session): Pine v6 with
// calc_bars_count pinning EVERY hidden data stream to a fixed history
// (5m/1m: 1500 bars; daily: 15). Two bugs die at once: the memory-limit
// crash on big-timeframe charts (14 streams no longer inherit the host
// chart's loaded range) and the label-flicker-by-chart-TF Eric caught
// (same warmup everywhere -> same EMAs/ATR/thresholds -> identical
// cells on any chart; the design's 'one 5m truth per symbol' is now
// actually true). Momentum parity with Bot v2.4: completed-bar legs
// (wick rule at the panel), a 4th IGNITION leg (3 closed bars netting
// >1.5x ATR), labels 3-4 STRONG / 2 GOOD / 1 WEAK / 0 SIDEWAYS, and
// hysteresis on the chop gate (enter >=4 crosses, exit <=2).
// WATCHTOWER TAPE SCANNER v1.7 (history below)
// v1.7 (2026-08-31, Eric's day-one live read): the 1M column speaks
// the SAME language as the RETEST column (TEST 8/21, 8/21 BULL/BEAR,
// WAIT) and is active ONLY while the row's scan-TF trend is on — and
// only in that trend's direction (counter-trend 1m signals are
// suppressed). BLANK = not even looking (5m not trending); WAIT =
// looking, nothing at the 1m EMAs. This reverses v1.6's independent
// design at Eric's call: "the 1 min may give too many signals if we
// are only looking for that trend." The 1M column never touches READY.
// v1.6 (2026-08-31): the 1M column, first cut (independent, GO UP/DN).
// WATCHTOWER TAPE SCANNER v1.5
// v1.5 (2026-08-31, Eric's spec — "I need to know when something is
// retesting NOW"): RETEST is two explicit states. TEST 8/21 (amber) =
// the CURRENT bar is straddling the EMA in a trend — the fight, live.
// 8/21 BULL/BEAR (green/red) = the touch RESOLVED on the just-closed
// bar (wick rule: the close held the level), looking back only rtLook
// CONFIRMED bars (default 1 — the bar that just closed, nothing
// older). READY requires the RESOLVED state, never the live test.
// v1.4 (2026-08-31): retest lookback became an input (was hardcoded 5).
// Seven symbols, one question: which chart deserves attention right now?
// READY > BUILDING > NO SETUP, momentum tiebreak. Confirmed bars only.
// The engine reads EXTENDED-session data (so it always knows what time it
// is), but RETEST and READY are decided by REGULAR-session bars only — and
// a second gate in the outer scope forces WAIT/NO SETUP whenever the chart
// clock is outside 9:30–16:00. The corner badge shows the session state.
//
// Committed 2026-08-31 (the NVDA "8 BEAR" question): this script lived only
// in the TradingView editor until Eric's cell-vs-eye dispute proved an
// unauditable indicator is a standing risk. The RETEST semantics, from
// source: "8 BEAR" = trend bearish AND one of the last 5 RTH bars wicked
// into the 8 EMA and closed rejected AND the current close is still below
// the 8. Stateless — it re-evaluates every bar and self-clears on a close
// above the 8. The NVDA verdict: the cell was RIGHT (close 219.55 vs 8 EMA
// 219.57); the chart legend was frozen on a crosshaired morning bar.
// Known limitation vs Tape Bot v2.0+: PDH/PDL here use plain daily [1]
// (fine live; can read stale on weekends — off-hours gates already force
// WAIT/NO SETUP, so the staleness is cosmetic).
// ─────────────────────────────────────────────────────────────────────────────
indicator("Watchtower Tape Scanner", overlay = true)

// ── Inputs ───────────────────────────────────────────────────────────────────
uni    = input.string("MAG 7", "Universe", options = ["MAG 7", "CUSTOM 7"])
scanTF = input.string("5",  "Scan timeframe (minutes)", options = ["5", "15"])
orbMin = input.int(30, "ORB minutes", options = [15, 30])
use1m  = input.bool(true, "1M trigger column (1-minute 8/21 retest, active only while the scan-TF trend is on)")
rtLook = input.int(1, "Resolved-retest memory (confirmed bars)", minval = 1, maxval = 5, tooltip = "How many CONFIRMED bars a resolved 8/21 BULL/BEAR stays lit after the close that proved it. 1 = only the bar that just closed. The live TEST state is always current-bar-only.")
nShow  = input.int(7, "Rows to show", minval = 1, maxval = 7)
tblPos = input.string("Top right", "Table position",
     options = ["Top right", "Top left", "Middle right", "Bottom right", "Bottom left"])
c1 = input.symbol("SPY",  "Custom 1"), c2 = input.symbol("QQQ",  "Custom 2")
c3 = input.symbol("IWM",  "Custom 3"), c4 = input.symbol("TSLA", "Custom 4")
c5 = input.symbol("NVDA", "Custom 5"), c6 = input.symbol("AMD",  "Custom 6")
c7 = input.symbol("AAPL", "Custom 7")

s1 = uni == "MAG 7" ? "AAPL"  : c1
s2 = uni == "MAG 7" ? "MSFT"  : c2
s3 = uni == "MAG 7" ? "NVDA"  : c3
s4 = uni == "MAG 7" ? "AMZN"  : c4
s5 = uni == "MAG 7" ? "GOOGL" : c5
s6 = uni == "MAG 7" ? "META"  : c6
s7 = uni == "MAG 7" ? "TSLA"  : c7

// Extended-session tickers: the engine must see premarket/AH bars to know
// what time it is (default security series are RTH-only and freeze at 4PM).
x1 = ticker.modify(s1, session.extended)
x2 = ticker.modify(s2, session.extended)
x3 = ticker.modify(s3, session.extended)
x4 = ticker.modify(s4, session.extended)
x5 = ticker.modify(s5, session.extended)
x6 = ticker.modify(s6, session.extended)
x7 = ticker.modify(s7, session.extended)

// ── Per-symbol engine (runs in each symbol's own context) ────────────────────
f_scan() =>
    emaF = ta.ema(close, 8)
    emaS = ta.ema(close, 21)
    xU = ta.crossover(emaF, emaS)
    xD = ta.crossunder(emaF, emaS)
    cnt = 0
    for i = 1 to 14
        if (close[i] > emaS[i]) != (close[i + 1] > emaS[i + 1])
            cnt += 1
    var bool chopState = false
    chopState := chopState ? cnt > 2 : cnt >= 4
    choppy = chopState
    bull = emaF > emaS
    ctl = choppy ? 0 : xU ? 1 : xD ? -1 : bull ? 2 : -2
    spread = math.abs(emaF - emaS)
    expanding = spread > ta.sma(spread, 20)
    trend = choppy ? 0 : bull and close > emaS and expanding ? 1 : (not bull) and close < emaS and expanding ? -1 : 0
    rth = session.ismarket
    pre = session.ispremarket
    isNewDay = ta.change(time("D")) != 0
    var float pmH = na
    var float pmL = na
    if isNewDay
        pmH := na
        pmL := na
    if pre
        pmH := na(pmH) ? high : math.max(pmH, high)
        pmL := na(pmL) ? low : math.min(pmL, low)
    orbEndT = timestamp("America/New_York", year, month, dayofmonth, 9, 30 + orbMin, 0)
    inORB = rth and time < orbEndT
    var float orbH = na
    var float orbL = na
    var bool orbDone = false
    if isNewDay
        orbH := na
        orbL := na
        orbDone := false
    if inORB
        orbH := na(orbH) ? high : math.max(orbH, high)
        orbL := na(orbL) ? low : math.min(orbL, low)
    if rth and not inORB and not na(orbH)
        orbDone := true
    orb = not orbDone ? 9 : close > orbH ? 1 : close < orbL ? -1 : 0
    // v1.5 — two-state retest. Live: is THIS bar straddling the EMA?
    touch8  = low <= emaF and high >= emaF
    touch21 = low <= emaS and high >= emaS
    // Resolved: did a CONFIRMED bar (i >= 1) touch and CLOSE holding?
    r8b = false
    r21b = false
    r8s = false
    r21s = false
    for i = 1 to rtLook
        if session.ismarket[i]
            if trend == 1 and low[i] <= emaF[i] and close[i] > emaF[i]
                r8b := true
            if trend == 1 and low[i] <= emaS[i] and close[i] > emaS[i]
                r21b := true
            if trend == -1 and high[i] >= emaF[i] and close[i] < emaF[i]
                r8s := true
            if trend == -1 and high[i] >= emaS[i] and close[i] < emaS[i]
                r21s := true
    rt = not rth ? 0 :
         r8b  and close > emaF ? 1  :
         r21b and close > emaS ? 2  :
         r8s  and close < emaF ? -1 :
         r21s and close < emaS ? -2 :
         trend == 1  and touch8  ? 3  :
         trend == -1 and touch8  ? -3 :
         trend == 1  and touch21 ? 4  :
         trend == -1 and touch21 ? -4 : 0
    atr14 = ta.atr(14)
    rngX = ta.sma(high[1] - low[1], 5) / atr14[1]
    dirNet = math.sum(close[1] > open[1] ? 1 : -1, 6)
    dirRun = math.abs(dirNet)
    volX = volume[1] / ta.sma(volume[1], 20)
    ignite = math.abs(close[1] - close[4]) > 1.5 * atr14[1]
    mom = (rngX > 1.15 ? 1 : 0) + (dirRun >= 4 ? 1 : 0) + (volX > 1.2 ? 1 : 0) + (ignite ? 1 : 0)
    [ctl, trend, orb, rt, mom, close, pmH, pmL, dirNet]

// v1.7 — the 1-minute trigger engine: identical state encoding to the
// scan-TF retest (1/2 = 8/21 BULL, -1/-2 = 8/21 BEAR, 3/4 = TEST 8/21
// bull-side, -3/-4 bear-side, 0 = WAIT), computed on 1m bars with the
// 1m's own trend gate. The scan-TF gate is applied in the outer scope.
f_trig() =>
    emaF = ta.ema(close, 8)
    emaS = ta.ema(close, 21)
    cnt = 0
    for i = 1 to 14
        if (close[i] > emaS[i]) != (close[i + 1] > emaS[i + 1])
            cnt += 1
    choppy = cnt >= 4
    bull = emaF > emaS
    spread = math.abs(emaF - emaS)
    expanding = spread > ta.sma(spread, 20)
    trend = choppy ? 0 : bull and close > emaS and expanding ? 1 : (not bull) and close < emaS and expanding ? -1 : 0
    touch8  = low <= emaF and high >= emaF
    touch21 = low <= emaS and high >= emaS
    resd = 0
    if session.ismarket[1]
        if trend == 1 and low[1] <= emaF[1] and close[1] > emaF[1] and close > emaF
            resd := 1
        else if trend == 1 and low[1] <= emaS[1] and close[1] > emaS[1] and close > emaS
            resd := 2
        if trend == -1 and high[1] >= emaF[1] and close[1] < emaF[1] and close < emaF
            resd := -1
        else if trend == -1 and high[1] >= emaS[1] and close[1] < emaS[1] and close < emaS
            resd := -2
    not session.ismarket ? 0 : resd != 0 ? resd : trend == 1 and touch8 ? 3 : trend == -1 and touch8 ? -3 : trend == 1 and touch21 ? 4 : trend == -1 and touch21 ? -4 : 0

tfStr = scanTF
[ctlA, trA, orbA, rtA0, momA, clA, phA, plA, dmA] = request.security(x1, tfStr, f_scan(), calc_bars_count = 1500)
[ctlB, trB, orbB, rtB0, momB, clB, phB, plB, dmB] = request.security(x2, tfStr, f_scan(), calc_bars_count = 1500)
[ctlC, trC, orbC, rtC0, momC, clC, phC, plC, dmC] = request.security(x3, tfStr, f_scan(), calc_bars_count = 1500)
[ctlD, trD, orbD, rtD0, momD, clD, phD, plD, dmD] = request.security(x4, tfStr, f_scan(), calc_bars_count = 1500)
[ctlE, trE, orbE, rtE0, momE, clE, phE, plE, dmE] = request.security(x5, tfStr, f_scan(), calc_bars_count = 1500)
[ctlF, trF, orbF, rtF0, momF, clF, phF, plF, dmF] = request.security(x6, tfStr, f_scan(), calc_bars_count = 1500)
[ctlG, trG, orbG, rtG0, momG, clG, phG, plG, dmG] = request.security(x7, tfStr, f_scan(), calc_bars_count = 1500)
m1A = request.security(x1, "1", f_trig(), calc_bars_count = 1500)
m1B = request.security(x2, "1", f_trig(), calc_bars_count = 1500)
m1C = request.security(x3, "1", f_trig(), calc_bars_count = 1500)
m1D = request.security(x4, "1", f_trig(), calc_bars_count = 1500)
m1E = request.security(x5, "1", f_trig(), calc_bars_count = 1500)
m1F = request.security(x6, "1", f_trig(), calc_bars_count = 1500)
m1G = request.security(x7, "1", f_trig(), calc_bars_count = 1500)
pdA = request.security(s1, "D", high[1], calc_bars_count = 15), pdA2 = request.security(s1, "D", low[1], calc_bars_count = 15)
pdB = request.security(s2, "D", high[1], calc_bars_count = 15), pdB2 = request.security(s2, "D", low[1], calc_bars_count = 15)
pdC = request.security(s3, "D", high[1], calc_bars_count = 15), pdC2 = request.security(s3, "D", low[1], calc_bars_count = 15)
pdD = request.security(s4, "D", high[1], calc_bars_count = 15), pdD2 = request.security(s4, "D", low[1], calc_bars_count = 15)
pdE = request.security(s5, "D", high[1], calc_bars_count = 15), pdE2 = request.security(s5, "D", low[1], calc_bars_count = 15)
pdF = request.security(s6, "D", high[1], calc_bars_count = 15), pdF2 = request.security(s6, "D", low[1], calc_bars_count = 15)
pdG = request.security(s7, "D", high[1], calc_bars_count = 15), pdG2 = request.security(s7, "D", low[1], calc_bars_count = 15)

// Outer-scope session gate: whatever the engine froze, nothing RETESTs or
// READYs while the chart clock is outside regular hours.
live = session.ismarket
rtA = live ? rtA0 : 0, rtB = live ? rtB0 : 0, rtC = live ? rtC0 : 0
rtD = live ? rtD0 : 0, rtE = live ? rtE0 : 0, rtF = live ? rtF0 : 0
rtG = live ? rtG0 : 0
// 1M trigger gate (v1.7): the column exists only while the row's
// scan-TF trend is ON — 99 renders as BLANK ("not even looking").
// While active, counter-trend 1m signals suppress to 0 (WAIT); only
// signals in the 5m trend's direction print. sign(code) = direction.
f_gate1m(t, tr) =>
    not (live and use1m) or tr == 0 ? 99 : t != 0 and (t > 0) != (tr > 0) ? 0 : t
t1A = f_gate1m(m1A, trA), t1B = f_gate1m(m1B, trB), t1C = f_gate1m(m1C, trC)
t1D = f_gate1m(m1D, trD), t1E = f_gate1m(m1E, trE), t1F = f_gate1m(m1F, trF)
t1G = f_gate1m(m1G, trG)

// ── Row assembly, ranking, rendering ─────────────────────────────────────────
f_ctlTxt(c) => c == 1 ? "CROSS UP" : c == 2 ? "BUYERS" : c == -1 ? "CROSS DN" : c == -2 ? "SELLERS" : "RANGE"
f_orbTxt(o) => o == 9 ? "BUILDING" : o == 1 ? "ABOVE" : o == -1 ? "BELOW" : "INSIDE"
f_rtTxt(r)  => r == 1 ? "8 BULL" : r == 2 ? "21 BULL" : r == -1 ? "8 BEAR" : r == -2 ? "21 BEAR" : r == 3 or r == -3 ? "TEST 8" : r == 4 or r == -4 ? "TEST 21" : "WAIT"
f_momTxt(m, t) => m >= 3 ? "STRONG" : m == 2 ? "GOOD" : m == 1 ? "WEAK" : "SIDEWAYS"
// v1.9: net direction of the six scoring bars, display only — SIDEWAYS
// carries no arrow (zero force has no direction worth printing).
f_momArrow(d, m) => m == 0 ? "" : d > 0 ? " ▲" : d < 0 ? " ▼" : ""
f_lvl(cl, ph, pl, dh, dl) =>
    best = 10.0e10
    nm = "—"
    if not na(dh) and math.abs(cl - dh) < best
        best := math.abs(cl - dh)
        nm := cl > dh ? "PDH ABOVE" : "PDH BELOW"
    if not na(dl) and math.abs(cl - dl) < best
        best := math.abs(cl - dl)
        nm := cl > dl ? "PDL ABOVE" : "PDL BELOW"
    if not na(ph) and math.abs(cl - ph) < best
        best := math.abs(cl - ph)
        nm := cl > ph ? "PMH ABOVE" : "PMH BELOW"
    if not na(pl) and math.abs(cl - pl) < best
        best := math.abs(cl - pl)
        nm := cl > pl ? "PML ABOVE" : "PML BELOW"
    nm
f_status(t, r, m) =>
    // READY takes only a RESOLVED retest (codes 1/2, -1/-2) — a live,
    // unresolved TEST never makes the verdict (the wick rule).
    aligned = (t == 1 and (r == 1 or r == 2)) or (t == -1 and (r == -1 or r == -2))
    t != 0 and aligned and m >= 2 ? 2 : t != 0 ? 1 : 0

f_name(s) => array.get(str.split(s, ":"), array.size(str.split(s, ":")) - 1)
sy1 = f_name(s1), sy2 = f_name(s2), sy3 = f_name(s3), sy4 = f_name(s4)
sy5 = f_name(s5), sy6 = f_name(s6), sy7 = f_name(s7)

stA = f_status(trA, rtA, momA), stB = f_status(trB, rtB, momB), stC = f_status(trC, rtC, momC)
stD = f_status(trD, rtD, momD), stE = f_status(trE, rtE, momE), stF = f_status(trF, rtF, momF)
stG = f_status(trG, rtG, momG)

var int[] idx = array.new_int(7)
key(i) => (i == 0 ? stA * 10 + momA : i == 1 ? stB * 10 + momB : i == 2 ? stC * 10 + momC : i == 3 ? stD * 10 + momD : i == 4 ? stE * 10 + momE : i == 5 ? stF * 10 + momF : stG * 10 + momG)
if barstate.islast
    array.clear(idx)
    for i = 0 to 6
        array.push(idx, i)
    for i = 0 to 5
        for j = i + 1 to 6
            if key(array.get(idx, j)) > key(array.get(idx, i))
                tmp = array.get(idx, i)
                array.set(idx, i, array.get(idx, j))
                array.set(idx, j, tmp)

cHead = color.new(#1c2230, 0)
cG = color.new(#0d8f6f, 15)
cR = color.new(#c0392b, 15)
cW = color.new(#c07a1f, 15)
cN = color.new(#5a6373, 15)
f_c(t) => str.contains(t, "BULL") or str.contains(t, "UP") or str.contains(t, "BUYERS") or str.contains(t, "ABOVE") or t == "STRONG" or t == "READY" ? cG : str.contains(t, "BEAR") or str.contains(t, "DN") or str.contains(t, "SELLERS") or str.contains(t, "BELOW") ? cR : str.contains(t, "TEST") or t == "GOOD" or t == "BUILDING" or t == "WEAK" ? cW : cN
f_stTxt(s) => s == 2 ? "READY" : s == 1 ? "BUILDING" : "NO SETUP"

sessTxt = session.ismarket ? "RTH" : session.ispremarket ? "PRE" : session.ispostmarket ? "POST" : "CLOSED"
pos = tblPos == "Top left" ? position.top_left : tblPos == "Middle right" ? position.middle_right : tblPos == "Bottom right" ? position.bottom_right : tblPos == "Bottom left" ? position.bottom_left : position.top_right
var table scan = table.new(pos, 8, 8, border_width = 1, border_color = color.new(color.black, 60))
f_row(r, nm, ctl, tr, orb, rt, t1, mom, dm, st, kl) =>
    table.cell(scan, 0, r, nm, text_color = color.white, bgcolor = cHead)
    table.cell(scan, 1, r, f_ctlTxt(ctl), text_color = color.white, bgcolor = f_c(f_ctlTxt(ctl)))
    table.cell(scan, 2, r, kl, text_color = color.white, bgcolor = f_c(kl))
    table.cell(scan, 3, r, f_orbTxt(orb), text_color = color.white, bgcolor = f_c(f_orbTxt(orb)))
    table.cell(scan, 4, r, f_rtTxt(rt), text_color = color.white, bgcolor = f_c(f_rtTxt(rt)))
    t1txt = t1 == 99 ? "" : f_rtTxt(t1)
    table.cell(scan, 5, r, t1txt, text_color = color.white, bgcolor = t1txt == "" ? cN : f_c(t1txt))
    // arrow is display-only: color and READY still read the pure label
    table.cell(scan, 6, r, f_momTxt(mom, tr) + f_momArrow(dm, mom), text_color = color.white, bgcolor = f_c(f_momTxt(mom, tr)))
    table.cell(scan, 7, r, f_stTxt(st), text_color = color.white, bgcolor = st == 2 ? cG : st == 1 ? cW : cN)

if barstate.islast
    table.cell(scan, 0, 0, "WT · " + sessTxt, text_color = session.ismarket ? color.white : color.orange, bgcolor = cHead)
    table.cell(scan, 1, 0, scanTF + "M 8/21", text_color = color.white, bgcolor = cHead)
    table.cell(scan, 2, 0, "KEY LEVEL", text_color = color.white, bgcolor = cHead)
    table.cell(scan, 3, 0, "ORB", text_color = color.white, bgcolor = cHead)
    table.cell(scan, 4, 0, "RETEST", text_color = color.white, bgcolor = cHead)
    table.cell(scan, 5, 0, "1M", text_color = color.white, bgcolor = cHead)
    table.cell(scan, 6, 0, "MOMENTUM", text_color = color.white, bgcolor = cHead)
    table.cell(scan, 7, 0, "STATUS", text_color = color.white, bgcolor = cHead)
    shown = 0
    for k = 0 to 6
        if shown < nShow
            i = array.get(idx, k)
            if i == 0
                f_row(shown + 1, sy1, ctlA, trA, orbA, rtA, t1A, momA, dmA, stA, f_lvl(clA, phA, plA, pdA, pdA2))
            if i == 1
                f_row(shown + 1, sy2, ctlB, trB, orbB, rtB, t1B, momB, dmB, stB, f_lvl(clB, phB, plB, pdB, pdB2))
            if i == 2
                f_row(shown + 1, sy3, ctlC, trC, orbC, rtC, t1C, momC, dmC, stC, f_lvl(clC, phC, plC, pdC, pdC2))
            if i == 3
                f_row(shown + 1, sy4, ctlD, trD, orbD, rtD, t1D, momD, dmD, stD, f_lvl(clD, phD, plD, pdD, pdD2))
            if i == 4
                f_row(shown + 1, sy5, ctlE, trE, orbE, rtE, t1E, momE, dmE, stE, f_lvl(clE, phE, plE, pdE, pdE2))
            if i == 5
                f_row(shown + 1, sy6, ctlF, trF, orbF, rtF, t1F, momF, dmF, stF, f_lvl(clF, phF, plF, pdF, pdF2))
            if i == 6
                f_row(shown + 1, sy7, ctlG, trG, orbG, rtG, t1G, momG, dmG, stG, f_lvl(clG, phG, plG, pdG, pdG2))
            shown += 1

// ── Alert: a symbol turned READY on a confirmed bar ──────────────────────────
anyReady = stA == 2 or stB == 2 or stC == 2 or stD == 2 or stE == 2 or stF == 2 or stG == 2
newReady = barstate.isconfirmed and anyReady and not anyReady[1]
alertcondition(newReady, "WT Scanner — New READY", "Watchtower Tape Scanner: a symbol just turned READY")
