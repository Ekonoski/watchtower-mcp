//@version=5
// WATCHTOWER TAPE BOT v2.1
// CONTROL > LEVEL > TREND > SETUP > MOMENTUM. Confirmed closes only.
// v2.1 — futures made first-class (2026-08-29, the NQ check):
//   - Futures 24H toggle: with it ON (default), Globex overnight bars
//     vote — setups arm and alerts fire around the clock, badge shows
//     GLOBEX/RTH. OFF restores equities discipline (RTH decides).
//   - Futures premarket is the OVERNIGHT session, not the equity
//     4:00-9:30 window: ONH/ONL accumulate from the 18:00 ET Globex
//     open to the 9:30 equity open, so the line always sits on a wick
//     you can see. Stocks keep PMH/PML exactly as verified.
// v2.0 — ground-up recalibration of the level clocks. One rule, no
// market assumptions: HISTORY always uses the last completed day/week;
// the LIVE edge uses it too, unless the market has stopped printing
// bars (then the just-finished period is "previous"). Detection is
// from the chart's own bars; weeks additionally confirm against the
// weekly bar's scheduled close so a partial week can never promote.
// Capability matrix: PM/ON/ORB/session badge = intraday only; PD levels =
// intraday+daily; PW levels = intraday/daily/weekly; gamma slots = all.
indicator("Watchtower Tape Bot", overlay = true, max_lines_count = 60, max_labels_count = 60)

grpE   = "EMAs"
lenF   = input.int(8,  "Fast EMA", minval = 1, group = grpE)
lenS   = input.int(21, "Slow EMA", minval = 2, group = grpE)

grpL   = "Automatic levels"
usePD  = input.bool(true,  "Prev day high/low (PDH/PDL)",   group = grpL)
usePW  = input.bool(true,  "Prev week high/low (PWH/PWL)",  group = grpL)
usePM  = input.bool(true,  "Premarket / overnight high-low", group = grpL)
useORB = input.bool(true,  "Opening range (ORB)",           group = grpL)
orbMin = input.int(30, "ORB minutes", options = [15, 30], group = grpL)

grpF   = "Futures"
fut24  = input.bool(true, "Futures vote 24H (Globex bars arm setups and alerts)", group = grpF)

grpW   = "Watchtower levels (paste from the morning gamma board)"
useWT  = input.bool(true, "Enable Watchtower levels", group = grpW)
cwPx   = input.float(0.0, "Call wall  (CW)",  group = grpW)
pwPx   = input.float(0.0, "Put wall   (PW)",  group = grpW)
gfPx   = input.float(0.0, "Gamma flip (GF)",  group = grpW)
fvTop  = input.float(0.0, "FVG top    (FVT)", group = grpW)
fvBot  = input.float(0.0, "FVG bottom (FVB)", group = grpW)
c1Px   = input.float(0.0, "Custom     (C1)",  group = grpW)

grpS   = "Level style"
lvlW   = input.int(2, "Key-level line width", minval = 1, maxval = 4, group = grpS)
lvlTag = input.bool(true, "Label flags on levels", group = grpS)
colPD  = input.color(color.orange,  "PDH/PDL", group = grpS)
colPW  = input.color(color.lime,    "PWH/PWL", group = grpS)
colPM  = input.color(color.fuchsia, "PMH/PML or ONH/ONL", group = grpS)
colORB = input.color(color.aqua,    "ORB",     group = grpS)
colWT  = input.color(color.yellow,  "Watchtower slots", group = grpS)

grpA   = "Alerts"
alrtLv = input.bool(true, "Alert on level breaks", group = grpA)
alrtCt = input.bool(true, "Alert on 8/21 control flips", group = grpA)
alrtSt = input.bool(true, "Alert on fresh setup states", group = grpA)
dcFmt  = input.bool(true, "Format alerts for a Discord webhook", group = grpA)

grpD   = "Dashboard"
dashOn = input.bool(true, "Show dashboard", group = grpD)
dashSz = input.string("normal", "Text size", options = ["small", "normal", "large"], group = grpD)
lvlPct = input.float(1.0, "Key-level search width, pct of price", minval = 0.1, step = 0.1, group = grpD)

// ── Chart context ──
intra  = timeframe.isintraday
isFut  = syminfo.type == "futures"
sess24 = syminfo.type == "crypto" or syminfo.type == "forex"
okPD   = intra or timeframe.isdaily
okPW   = intra or timeframe.isdaily or timeframe.isweekly

inRTH  = intra and not na(time(timeframe.period, "0930-1600", "America/New_York"))
inPre  = intra and not sess24 and not na(time(timeframe.period, "0400-0930", "America/New_York"))
inPost = intra and not na(time(timeframe.period, "1600-2000", "America/New_York"))
canVote = not intra or sess24 or (isFut and fut24) or inRTH
sessTxt = not intra ? "EOD" : sess24 ? "24H" : isFut ? (inRTH ? "RTH" : "GLOBEX") : inRTH ? "RTH" : inPre ? "PRE" : inPost ? "POST" : "CLOSED"
isNewDay = intra and ta.change(time("D")) != 0
isNewWk  = okPW and ta.change(time("W")) != 0

emaF = ta.ema(close, lenF)
emaS = ta.ema(close, lenS)
plot(emaF, "EMA fast", color = color.new(color.aqua,   0), linewidth = 2)
plot(emaS, "EMA slow", color = color.new(color.orange, 0), linewidth = 2)

xUp = ta.crossover(emaF,  emaS)
xDn = ta.crossunder(emaF, emaS)

crossCnt = 0
for i = 1 to 14
    if (close[i] > emaS[i]) != (close[i + 1] > emaS[i + 1])
        crossCnt += 1
isChoppy = crossCnt >= 4

ctlBull   = emaF > emaS
ctlTxt    = xUp ? "CROSS UP" : xDn ? "CROSS DOWN" : isChoppy ? "RANGING" : ctlBull ? "BUYERS" : "SELLERS"
ctlIsRng  = ctlTxt == "RANGING"

// ── The clocks (v2.0) ──
// marketStopped: the chart's own last bar closed over an hour ago —
// no bars are printing, so the period that bar belongs to is finished.
// Only ever true on the last bar; historical bars always use the
// completed prior period (no repaint, ever). Futures traced too: the
// daily 17:00-18:00 ET halt is exactly one hour, so it never falsely
// promotes; the weekend does, correctly.
marketStopped = barstate.islast and timenow > time_close + 3600000
// Week completion additionally confirms against the weekly bar's own
// scheduled close, so a mid-week evening can never promote a partial
// week (stocks/futures: passes Fri close; crypto: at the UTC week end).
wEndT  = request.security(syminfo.tickerid, "W", time_close, lookahead = barmerge.lookahead_on)
wkOver = barstate.islast and not na(wEndT) and timenow >= wEndT

// ── Day range from the chart's own bars ──
var float cDh = na
var float cDl = na
var float pDh = na
var float pDl = na
if intra
    if isNewDay
        pDh := cDh
        pDl := cDl
        cDh := high
        cDl := low
    else
        cDh := na(cDh) ? high : math.max(cDh, high)
        cDl := na(cDl) ? low  : math.min(cDl, low)
if timeframe.isdaily
    cDh := high
    cDl := low
    pDh := high[1]
    pDl := low[1]
// ── Week range from the chart's own bars ──
var float cWh = na
var float cWl = na
var float pWh = na
var float pWl = na
if intra or timeframe.isdaily
    if isNewWk
        pWh := cWh
        pWl := cWl
        cWh := high
        cWl := low
    else
        cWh := na(cWh) ? high : math.max(cWh, high)
        cWl := na(cWl) ? low  : math.min(cWl, low)
if timeframe.isweekly
    cWh := high
    cWl := low
    pWh := high[1]
    pWl := low[1]

float pdh = na
float pdl = na
float pwh = na
float pwl = na
if okPD
    pdh := marketStopped ? cDh : pDh
    pdl := marketStopped ? cDl : pDl
if okPW
    pwh := wkOver ? cWh : pWh
    pwl := wkOver ? cWl : pWl

// ── Premarket (stocks) / overnight (futures) range ──
// Stocks: the 4:00-9:30 ET equity premarket, as verified.
// Futures (v2.1): "premarket" is the wrong concept — the level that
// matters is the OVERNIGHT session high/low, accumulated from the
// 18:00 ET Globex open (the day reset) until the 9:30 equity open,
// then frozen for the day. Labeled ONH/ONL so nobody mistakes it.
var float pmH = na
var float pmL = na
var bool  rthSeen = false
if isNewDay
    pmH := na
    pmL := na
    rthSeen := false
if inRTH
    rthSeen := true
inON = isFut and intra and not inRTH and not rthSeen
if isFut ? inON : inPre
    pmH := na(pmH) ? high : math.max(pmH, high)
    pmL := na(pmL) ? low  : math.min(pmL, low)
pmHi = isFut ? "ONH" : "PMH"
pmLo = isFut ? "ONL" : "PML"

orbEndT = timestamp("America/New_York", year, month, dayofmonth, 9, 30 + orbMin, 0)
inORB   = inRTH and time < orbEndT and not sess24
var float orbH = na
var float orbL = na
var bool  orbDone = false
if isNewDay
    orbH := na
    orbL := na
    orbDone := false
if inORB
    orbH := na(orbH) ? high : math.max(orbH, high)
    orbL := na(orbL) ? low  : math.min(orbL, low)
if inRTH and not inORB and not na(orbH)
    orbDone := true

var string[] lvlNames  = array.new_string()
var float[]  lvlPrices = array.new_float()
array.clear(lvlNames)
array.clear(lvlPrices)
f_add(nm, px) =>
    if not na(px) and px > 0
        array.push(lvlNames, nm)
        array.push(lvlPrices, px)
if usePD and okPD
    f_add("PDH", pdh)
    f_add("PDL", pdl)
if usePW and okPW
    f_add("PWH", pwh)
    f_add("PWL", pwl)
if usePM and intra and not sess24
    f_add(pmHi, pmH)
    f_add(pmLo, pmL)
if useORB and orbDone and intra
    f_add("ORB H", orbH)
    f_add("ORB L", orbL)
if useWT
    f_add("CW",  cwPx)
    f_add("PW",  pwPx)
    f_add("GF",  gfPx)
    f_add("FVT", fvTop)
    f_add("FVB", fvBot)
    f_add("C1",  c1Px)

float nearPx  = na
string nearNm = na
if array.size(lvlPrices) > 0
    bestD = close * lvlPct / 100.0
    for i = 0 to array.size(lvlPrices) - 1
        d = math.abs(close - array.get(lvlPrices, i))
        if d <= bestD
            bestD  := d
            nearPx := array.get(lvlPrices, i)
            nearNm := array.get(lvlNames, i)

f_lvlCol(nm) =>
    nm == "PDH" or nm == "PDL" ? colPD : nm == "PWH" or nm == "PWL" ? colPW : nm == "PMH" or nm == "PML" or nm == "ONH" or nm == "ONL" ? colPM : nm == "ORB H" or nm == "ORB L" ? colORB : colWT

var line[]  lvlLines  = array.new_line()
var label[] lvlLabels = array.new_label()
if barstate.islast
    while array.size(lvlLines) > 0
        line.delete(array.pop(lvlLines))
    while array.size(lvlLabels) > 0
        label.delete(array.pop(lvlLabels))
    if array.size(lvlPrices) > 0
        for i = 0 to array.size(lvlPrices) - 1
            px  = array.get(lvlPrices, i)
            nm  = array.get(lvlNames, i)
            col = f_lvlCol(nm)
            array.push(lvlLines, line.new(bar_index - 300, px, bar_index, px, extend = extend.right, color = color.new(col, 15), style = line.style_solid, width = lvlW))
            if lvlTag
                array.push(lvlLabels, label.new(bar_index + 8, px, nm, style = label.style_label_left, color = color.new(col, 0), textcolor = color.black, size = size.normal))

var string  st       = "IDLE"
var float   stLvl    = na
var string  stLvlNm  = na
var int     stAge    = 0
band = close * 0.0015

if isNewDay
    st      := "IDLE"
    stLvl   := na
    stLvlNm := na
    stAge   := 0

if barstate.isconfirmed and canVote
    stAge += 1
    if not na(nearPx)
        brokeUp = close > nearPx and close[1] <= nearPx
        brokeDn = close < nearPx and close[1] >= nearPx
        if brokeUp or brokeDn
            st      := brokeUp ? "BROKE UP" : "BROKE DOWN"
            stLvl   := nearPx
            stLvlNm := nearNm
            stAge   := 0
    if not na(stLvl)
        touching = low <= stLvl + band and high >= stLvl - band
        if (st == "BROKE UP" or st == "BROKE DOWN") and stAge >= 1
            st := st == "BROKE UP" ? "WAIT RETEST UP" : "WAIT RETEST DN"
        if st == "WAIT RETEST UP" and touching
            st := close > stLvl ? "RETEST BULL" : "RETEST FAIL"
        if st == "WAIT RETEST DN" and touching
            st := close < stLvl ? "RETEST BEAR" : "RECLAIMED"
        if st == "RETEST BULL"
            st := close > stLvl ? (stAge > 3 ? "HELD BULL" : st) : "LOST"
        if st == "RETEST BEAR"
            st := close < stLvl ? (stAge > 3 ? "HELD BEAR" : st) : "RECLAIMED"
        if st == "RETEST FAIL" or st == "LOST" or st == "RECLAIMED" or stAge > 40
            st      := "IDLE"
            stLvl   := na
            stLvlNm := na

setupTxt = not canVote ? (st == "IDLE" ? "CLOSED" : "CLOSED - was " + st) : st == "IDLE" ? "NO ACTIVE SETUP" : na(stLvlNm) ? st : stLvlNm + " " + st

lvlTxt = na(nearNm) ? "NO LEVEL NEAR" : nearNm + (close > nearPx ? " ABOVE" : " BELOW")

spread    = math.abs(emaF - emaS)
spreadAvg = ta.sma(spread, 20)
expanding = spread > spreadAvg
trendTxt  = ctlIsRng or isChoppy ? "RANGING" : ctlBull and close > emaS and expanding ? "TRENDING BULL" : (not ctlBull) and close < emaS and expanding ? "TRENDING BEAR" : "RANGING"

atr14   = ta.atr(14)
rngX    = ta.sma(high - low, 5) / atr14
dirRun  = math.abs(math.sum(close > open ? 1 : -1, 6))
volX    = volume / ta.sma(volume, 20)
score   = (rngX > 1.15 ? 1 : 0) + (dirRun >= 4 ? 1 : 0) + (volX > 1.2 ? 1 : 0)
momTxt  = not canVote ? "CLOSED" : trendTxt == "RANGING" and score <= 1 ? "SIDEWAYS" : score >= 3 ? "STRONG" : score == 2 ? "GOOD" : "WEAK"

cGood = color.new(#0d8f6f, 20)
cBad  = color.new(#c0392b, 20)
cWarn = color.new(#c07a1f, 20)
cGray = color.new(#5a6373, 20)
cHead = color.new(#1c2230, 0)
f_dir(txt) => txt == "CROSS UP" or txt == "BUYERS" or txt == "TRENDING BULL" or str.contains(txt, "BULL") or str.contains(txt, "ABOVE") or str.contains(txt, "RECLAIMED") ? cGood : txt == "CROSS DOWN" or txt == "SELLERS" or txt == "TRENDING BEAR" or str.contains(txt, "BEAR") or str.contains(txt, "BELOW") or str.contains(txt, "LOST") ? cBad : cGray
momCol = momTxt == "STRONG" ? cGood : momTxt == "GOOD" ? color.new(#2e7d32, 20) : momTxt == "WEAK" ? cWarn : cGray

txSz = dashSz == "small" ? size.small : dashSz == "large" ? size.large : size.normal
var table dash = table.new(position.top_right, 2, 6, border_width = 1, border_color = color.new(color.black, 60))
if dashOn and barstate.islast
    table.cell(dash, 0, 0, "WATCHTOWER", text_color = color.white, bgcolor = cHead, text_size = txSz)
    table.cell(dash, 1, 0, "WT - " + sessTxt, text_color = color.white, bgcolor = canVote ? cHead : cWarn, text_size = txSz)
    table.cell(dash, 0, 1, "8/21 CONTROL", text_color = color.white, bgcolor = cHead, text_size = txSz)
    table.cell(dash, 1, 1, ctlTxt,   text_color = color.white, bgcolor = f_dir(ctlTxt),   text_size = txSz)
    table.cell(dash, 0, 2, "KEY LEVEL", text_color = color.white, bgcolor = cHead, text_size = txSz)
    table.cell(dash, 1, 2, lvlTxt,   text_color = color.white, bgcolor = f_dir(lvlTxt),   text_size = txSz)
    table.cell(dash, 0, 3, "TREND", text_color = color.white, bgcolor = cHead, text_size = txSz)
    table.cell(dash, 1, 3, trendTxt, text_color = color.white, bgcolor = f_dir(trendTxt), text_size = txSz)
    table.cell(dash, 0, 4, "ACTIVE SETUP", text_color = color.white, bgcolor = f_dir(setupTxt), text_size = txSz)
    table.cell(dash, 1, 4, setupTxt, text_color = color.white, bgcolor = f_dir(setupTxt), text_size = txSz)
    table.cell(dash, 0, 5, "MOMENTUM", text_color = color.white, bgcolor = cHead, text_size = txSz)
    table.cell(dash, 1, 5, momTxt,   text_color = color.white, bgcolor = momCol,          text_size = txSz)

f_say(msg) =>
    m = syminfo.ticker + " " + timeframe.period + ": " + msg
    alert(dcFmt ? '{"content": "WT | ' + m + '"}' : m, alert.freq_once_per_bar_close)

if barstate.isconfirmed and canVote
    if alrtLv and array.size(lvlPrices) > 0
        for i = 0 to array.size(lvlPrices) - 1
            px = array.get(lvlPrices, i)
            nm = array.get(lvlNames, i)
            if close > px and close[1] <= px
                f_say("closed ABOVE " + nm + " " + str.tostring(px, format.mintick) + " at " + str.tostring(close, format.mintick))
            if close < px and close[1] >= px
                f_say("closed BELOW " + nm + " " + str.tostring(px, format.mintick) + " at " + str.tostring(close, format.mintick))
    if alrtCt and xUp
        f_say("8/21 CROSS UP - buyers take control")
    if alrtCt and xDn
        f_say("8/21 CROSS DOWN - sellers take control")
    if alrtSt and st != st[1] and (st == "RETEST BULL" or st == "RETEST BEAR" or st == "HELD BULL" or st == "HELD BEAR")
        f_say("setup: " + (na(stLvlNm) ? st : stLvlNm + " " + st))

freshRB = barstate.isconfirmed and canVote and st == "RETEST BULL" and st[1] != "RETEST BULL"
freshRS = barstate.isconfirmed and canVote and st == "RETEST BEAR" and st[1] != "RETEST BEAR"
ready   = barstate.isconfirmed and canVote and trendTxt != "RANGING" and (momTxt == "GOOD" or momTxt == "STRONG") and (str.contains(setupTxt, "RETEST BULL") or str.contains(setupTxt, "RETEST BEAR") or str.contains(setupTxt, "HELD"))
alertcondition(freshRB, "WT Retest BULL",  "Watchtower Tape Bot: fresh RETEST BULL confirmed")
alertcondition(freshRS, "WT Retest BEAR",  "Watchtower Tape Bot: fresh RETEST BEAR confirmed")
alertcondition(ready,   "WT READY",        "Watchtower Tape Bot: trend + retest + momentum aligned")
