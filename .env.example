# ============================================================
# Watchtower MCP (Railway / custom Grok connector)
# Copy values from your local watchtower/.env into the Railway
# service Variables for the watchtower-mcp service.
# ============================================================

# Auth for /mcp (recommended for public Railway URL + Grok custom connector)
# Clients send: Authorization: Bearer <this>  or  X-MCP-Token: <this>
MCP_AUTH_TOKEN=your-strong-random-token-here

# xAI for Grok synthesis in research + get_daily_report + theses
XAI_API_KEY=your_xai_api_key_here

# Polygon.io (or Massive.com) - REQUIRED for the custom connector
# to return rich live data for momentum (Sleeve 2 up-and-comers),
# bearish/breakdown (Sleeve 3 puts), regime (SPY 200MA), RS vs SPY,
# volume surge, and accurate research theses.
# Without this, live fallbacks are limited and many GMMSS tools
# will be weak or artifact-only.
POLYGON_API_KEY=your_polygon_api_key_here

# Supabase direct DB (psycopg2) - required for screens that load
# quality_universe + prices when no local CSVs are present.
SUPABASE_DB_HOST=aws-1-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.ktstmsbfmslvluhqnydb
SUPABASE_DB_PASSWORD=your_db_password_here
SUPABASE_DB_NAME=postgres

# FMP (some ingests / enrichment)
FMP_API_KEY=your_fmp_api_key_here

# Resend (only if daily report path or emails are exercised from MCP)
RESEND_API_KEY=your_resend_key_here
RESEND_FROM="Watchtower <onboarding@resend.dev>"
ALERT_EMAIL_TO=your_email@example.com

# Railway will set PORT automatically. Set MCP_HOST=0.0.0.0 in Variables too.
MCP_HOST=0.0.0.0
